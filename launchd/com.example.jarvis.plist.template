<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.YOUR_USERNAME.jarvis</string>
  <key>ProgramArguments</key>
  <array>
    <!-- 用 Nemotron 那個 venv 的 python（跟 nemotron-asr-test 共用環境與模型）-->
    <string>/Users/YOUR_USERNAME/nemotron-asr-test/.venv/bin/python</string>
    <string>-u</string>
    <string>/Users/YOUR_USERNAME/jarvis/jarvis.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOUR_USERNAME/jarvis</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/YOUR_USERNAME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- 登入後自動啟動；當掉（非正常結束）30 秒後自動重開。正常結束（說「賈維斯關機」）不會被重開 -->
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>/Users/YOUR_USERNAME/jarvis/run.out</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USERNAME/jarvis/run.err</string>
</dict>
</plist>
